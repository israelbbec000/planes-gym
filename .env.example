# Copia este archivo a .env y llena los valores. NUNCA subas .env a git.

# --- ElevenLabs (solo si voz.modo = "elevenlabs" en config.json) ---
ELEVENLABS_API_KEY=

# --- TikTok Content Posting API (solo para el publicador) ---
# Se obtienen en https://developers.tiktok.com/ al crear tu app
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Debe coincidir EXACTO con el Redirect URI registrado en tu app de TikTok
TIKTOK_REDIRECT_URI=http://localhost:8765/callback
